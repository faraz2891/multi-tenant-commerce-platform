DATABASE_URL="postgresql://postgres:password@localhost:5432/commerce?schema=public"
AUTH_ACCESS_TOKEN_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Required only when provisioning the first tenant administrator with `npm run db:seed`.
INITIAL_TENANT_NAME="Example Store"
INITIAL_TENANT_SLUG="example-store"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
